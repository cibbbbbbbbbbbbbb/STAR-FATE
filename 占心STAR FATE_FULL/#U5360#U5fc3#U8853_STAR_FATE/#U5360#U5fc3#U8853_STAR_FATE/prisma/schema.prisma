generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String?         @map("password_hash")
  name          String?
  googleId      String?         @unique @map("google_id")
  role          UserRole        @default(user)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  sessions      Session[]
  fortuneResults FortuneResult[]
  coupleFortunes CoupleFortune[]
  dailyFortunes DailyFortune[]
  orders        Order[]
  paidResults   PaidResult[]
  favorites     Favorite[]
  shares        Share[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model FortuneResult {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  question   String?
  birthDate  DateTime @map("birth_date") @db.Date
  birthTime  String?  @map("birth_time")
  gender     String?
  bloodType  String?  @map("blood_type")
  zodiac     String?
  resultData Json     @map("result_data")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites  Favorite[]
  shares     Share[]

  @@index([userId, createdAt])
  @@map("fortune_results")
}

model CoupleFortune {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  personAData   Json     @map("person_a_data")
  personBData   Json     @map("person_b_data")
  resultData    Json     @map("result_data")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("couple_fortunes")
}

model DailyFortune {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  fortuneDate DateTime @map("fortune_date") @db.Date
  birthDate  DateTime @map("birth_date") @db.Date
  resultData Json     @map("result_data")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fortuneDate, birthDate])
  @@index([userId, fortuneDate])
  @@map("daily_fortunes")
}

model Product {
  id          String      @id
  name        String
  slug        String      @unique
  description String?
  price       Int
  currency    String      @default("TWD")
  status      ProductStatus @default(active)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orders      Order[]
  paidResults PaidResult[]

  @@map("products")
}

model Order {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  productId        String        @map("product_id")
  amount           Int
  currency         String        @default("TWD")
  status           OrderStatus   @default(pending)
  paymentProvider  String?       @map("payment_provider")
  paymentReference String?       @map("payment_reference")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  paidResults      PaidResult[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model PaidResult {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  userId     String   @map("user_id")
  productId  String   @map("product_id")
  resultData Json     @map("result_data")
  createdAt  DateTime @default(now()) @map("created_at")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("paid_results")
}

model Favorite {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  fortuneId String        @map("fortune_id")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fortune   FortuneResult @relation(fields: [fortuneId], references: [id], onDelete: Cascade)

  @@unique([userId, fortuneId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Share {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  fortuneId  String        @map("fortune_id")
  shareToken String        @unique @map("share_token")
  createdAt  DateTime      @default(now()) @map("created_at")
  expiresAt  DateTime?     @map("expires_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fortune    FortuneResult @relation(fields: [fortuneId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("shares")
}

enum UserRole {
  user
  admin
}

enum ProductStatus {
  active
  inactive
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}
